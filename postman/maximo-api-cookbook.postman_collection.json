{
  "info": {
    "name": "Maximo API Cookbook",
    "description": "Recipes for the IBM Maximo REST/JSON API (Manage on MAS). Set baseUrl in the collection variables. Each request sends an apikey header read from {{apikey}}: keep the real key in a Postman environment, never in this file. Requests are added as each recipe is tested.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://<workspace>.manage.<instance>.<domain>/maximo" },
    { "key": "siteid", "value": "BEDFORD" }
  ],
  "item": [
    {
      "name": "01 Who am I",
      "request": {
        "method": "GET",
        "header": [
          { "key": "apikey", "value": "{{apikey}}", "type": "text" }
        ],
        "url": "{{baseUrl}}/api/whoami"
      }
    },
    {
      "name": "02 Query work orders",
      "request": {
        "method": "GET",
        "header": [
          { "key": "apikey", "value": "{{apikey}}", "type": "text" }
        ],
        "url": "{{baseUrl}}/api/os/mxapiwodetail?lean=1&oslc.select=wonum,description,status,assetnum,reportdate&oslc.where=siteid=\"{{siteid}}\" and status=\"WAPPR\"&oslc.orderBy=-reportdate&oslc.pageSize=20"
      }
    }
  ]
}
